        "zipCode": {
            "title": "ZIP code (radius search)",
            "type": "string",
            "description": "Search around this 5-digit ZIP code instead of whole states.",
            "editor": "textfield",
            "sectionCaption": "Or search around a ZIP code"
        },
        "radiusMiles": {
            "title": "Radius (miles)",
            "type": "integer",
            "description": "How far from the ZIP code to search.",
            "default": 25,
            "minimum": 1,
            "maximum": 300,
            "unit": "miles"
        },
        "cities": {
            "title": "Only these cities",
            "type": "array",
            "description": "Optional. Keep only locations in these cities, for example Columbus or Dayton.",
            "editor": "stringList",
            "sectionCaption": "Filters"
        },
        "registeredWithinDays": {
            "title": "Only newly registered (days)",
            "type": "integer",
            "description": "Optional. Keep only organizations that got their NPI in the last N days, a good signal for new practices that are still choosing vendors. 0 means no limit.",
            "default": 0,
            "minimum": 0,
            "maximum": 36500,
            "unit": "days"
        },
        "primarySpecialtyOnly": {
            "title": "Primary specialty must match",
            "type": "boolean",
            "description": "On: a location counts only when its main specialty is in your categories. Off: also include organizations that list your category as a secondary specialty (for example a multi-specialty group that also does cardiology).",
            "default": true
        },
        "requirePhone": {
            "title": "Only with a phone number",
            "type": "boolean",
            "description": "Drop locations without a phone number (rare).",
            "default": false
        },
        "requireWebsite": {
            "title": "Only with a website",
            "type": "boolean",
            "description": "Keep only locations where a website was found. Websites come from OpenStreetMap and cover a minority of practices, so this cuts the list a lot.",
            "default": false
        },
        "findWebsites": {
            "title": "Look up websites and opening hours",
            "type": "boolean",
            "description": "Match locations to OpenStreetMap to add websites, role emails, opening hours and exact map points where available. Best effort; adds up to a minute or so.",
            "default": true
        },
        "maxResults": {
            "title": "Maximum results",
            "type": "integer",
            "description": "Stop after this many locations. You pay per location returned.",
            "default": 1000,
            "minimum": 1,
            "maximum": 200000,
            "prefill": 100
        }
    },
    "required": [
        "categories"
    ]
}
